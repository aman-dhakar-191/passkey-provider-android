<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub channel only: the self-updater (src/github/java/.../update). Store builds contain none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver
            android:name="io.github.amandhakar.passkey.update.InstallResultReceiver"
            android:exported="false" />

        <!-- BETA: device-setup credential transfer (devicesetup/PasskeyDeviceSetupService). Exported so Google
             Play services can bind it; the androidx library rejects every caller that isn't Play services. -->
        <service
            android:name="io.github.amandhakar.passkey.devicesetup.PasskeyDeviceSetupService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.credentials.DEVICE_SETUP_SERVICE_ACTION" />
            </intent-filter>
        </service>
    </application>
</manifest>
