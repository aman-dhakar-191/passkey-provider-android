<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub channel only: moving passkeys to a new phone (src/github/java/.../transfer) and Backup & recovery
     (src/github/java/.../recovery). Store builds contain none of this. There is no self-updater: updates come
     from the private app store. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backup & recovery reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Moving passkeys to another phone (src/github/java/.../transfer). Opened only from the app's menu. -->
        <activity
            android:name="io.github.amandhakar.passkey.transfer.TransferActivity"
            android:exported="false"
            android:label="Move passkeys" />

        <!-- Backup & recovery (src/github/java/.../recovery). Opened only from the app's menu and its own
             reminder notification. -->
        <activity
            android:name="io.github.amandhakar.passkey.recovery.BackupActivity"
            android:exported="false"
            android:label="Backup &amp; recovery" />
    </application>
</manifest>
