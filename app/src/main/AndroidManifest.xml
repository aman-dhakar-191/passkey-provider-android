<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Firebase adds the advertising-ID permission; the app shows no ads and never reads that ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".PasskeyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Passkey">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Second launcher icon, "Scan QR": goes straight to the passkey QR scanner, in its own task so it
             works even while the app is open, and leaves nothing in Recents. -->
        <activity
            android:name=".ui.ScanQrActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_scan"
            android:label="@string/scan_qr_label"
            android:taskAffinity="${applicationId}.scan"
            android:theme="@style/Theme.Passkey.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shows the stack trace of the last crash; separate process so it survives the crash. -->
        <activity
            android:name=".CrashActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":crash" />

        <!-- Launched by Credential Manager through our PendingIntents; only show the auth prompt. -->
        <activity
            android:name=".provider.CreatePasskeyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Passkey.Transparent" />
        <activity
            android:name=".provider.GetPasskeyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Passkey.Transparent" />

        <service
            android:name=".provider.PasskeyProviderService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>


        <!-- Firebase Analytics and Crashlytics: on in release builds, off in debug/minified (see app/build.gradle.kts). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="${telemetry}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${telemetry}" />

        <!-- Download the QR scanner module at install time instead of on first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
    </application>
</manifest>
