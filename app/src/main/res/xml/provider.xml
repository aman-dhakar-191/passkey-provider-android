<?xml version="1.0" encoding="utf-8"?>
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Must match the request type exactly. Passkeys use the androidx.* name
         (PublicKeyCredential.TYPE_PUBLIC_KEY_CREDENTIAL); with the android.* name Credential Manager
         never asks this provider for passkeys. -->
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
